# Never into the build context: secrets and health data.
.env
.env.*
!.env.example
data/
*.fit
*.db
*.sqlite*
.garth/
.garminconnect/
tokens.json

.git/
.github/
.claude/
.venv/
node_modules/
# A local build must not reach the context: the image's frontend comes
# from the node stage, and a stale dist in the context is a stale dist
# nobody notices. The .tsbuildinfo files would make `tsc -b` skip the
# type check in that stage for the same reason.
web/dist/
*.tsbuildinfo
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
design/
docs/
tests/
Dockerfile
docker-compose.yml
