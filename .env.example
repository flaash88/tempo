# Tempo — example configuration.
# Copy to .env and fill in. Never commit .env.

# --- intervals.icu -----------------------------------------------------
# Basic auth: username is the literal string API_KEY, password is this key.
INTERVALS_API_KEY=
# 0 is the self-reference for the authenticated athlete.
INTERVALS_ATHLETE_ID=0

# --- Anthropic ---------------------------------------------------------
ANTHROPIC_API_KEY=
# Daily assessment and chat.
ANTHROPIC_MODEL_DAILY=claude-sonnet-5
# Week and block planning.
ANTHROPIC_MODEL_PLANNING=claude-opus-5
# Hard stop once the month's spend reaches this budget, in EUR.
TEMPO_MONTHLY_BUDGET_EUR=10

# --- Authentication ----------------------------------------------------
# Single user. Generate with: uv run tempo hash-password
TEMPO_PASSWORD_HASH=

# --- Optional Garmin direct connector ----------------------------------
# Off by default, and the app is complete without it. Only supplies Body
# Battery and Training Readiness, which intervals.icu does not carry.
# Needs the extra: uv sync --extra garmin
GARMIN_DIRECT_ENABLED=false
GARMIN_EMAIL=
GARMIN_PASSWORD=
