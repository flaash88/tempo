# Tempo — example configuration.
# Copy to .env and fill in. Never commit .env.
#
# Every variable the application reads belongs in this file and in the
# README's table; a test checks that none of the three drifts apart.

# --- Storage -----------------------------------------------------------
# Database and raw FIT files. Inside the container this is the mounted
# volume, so leaving it alone is usually right.
TEMPO_DATA_DIR=data

# --- intervals.icu -----------------------------------------------------
# Basic auth: username is the literal string API_KEY, password is this key.
INTERVALS_API_KEY=
# 0 is the self-reference for the authenticated athlete.
INTERVALS_ATHLETE_ID=0

# --- Anthropic ---------------------------------------------------------
ANTHROPIC_API_KEY=
# Daily assessment and chat.
ANTHROPIC_MODEL_DAILY=claude-sonnet-5
# Week and block planning.
ANTHROPIC_MODEL_PLANNING=claude-opus-5
# Hard stop once the month's spend reaches this budget, in EUR.
# 0 permits nothing, which is how the AI layer is switched off.
TEMPO_MONTHLY_BUDGET_EUR=10
# How much of a chat conversation travels with a question. Both are capped
# again in the code (12 turns, 2000 characters) and the whole history is
# then cut to 4 KB — the same ceiling the feature document has, so a long
# conversation is not a way around it.
TEMPO_CHAT_MAX_TURNS=6
TEMPO_CHAT_MAX_MESSAGE_CHARS=1000

# --- Readiness ---------------------------------------------------------
# How much each input counts. These are a choice, not a derivation: the
# defaults below are documented in docs/DECISIONS.md and only the ratios
# matter, since the weights of the inputs that are present are renormalised.
# Set one and the other three keep their default.
# Note that during the build-up phase the form term contributes almost
# nothing, so readiness rests on HRV, resting heart rate and sleep.
TEMPO_READINESS_WEIGHT_HRV=0.40
TEMPO_READINESS_WEIGHT_RESTING_HR=0.20
TEMPO_READINESS_WEIGHT_SLEEP=0.20
TEMPO_READINESS_WEIGHT_TSB=0.20

# --- Authentication ----------------------------------------------------
# Single user. Generate with: uv run tempo hash-password
TEMPO_PASSWORD_HASH=

# --- Optional Garmin direct connector ----------------------------------
# Off by default, and the app is complete without it. Only supplies Body
# Battery and Training Readiness, which intervals.icu does not carry.
# Needs the extra: uv sync --extra garmin
GARMIN_DIRECT_ENABLED=false
GARMIN_EMAIL=
GARMIN_PASSWORD=
